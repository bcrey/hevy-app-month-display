# Hevy API key (needs Hevy Pro): https://hevy.com/settings?developer
# When set, workouts are read straight from Hevy and the Drive settings below are ignored
HEVY_API_KEY=

# Timezone used to put each workout on a calendar day (default America/Los_Angeles)
TIMEZONE=

# --- Fallback: latest Hevy CSV export in a Google Drive folder ---

# Google Cloud Console → APIs & Services → Credentials → API Key
# Restrict to Google Drive API only
GOOGLE_API_KEY=

# The folder ID from your Google Drive folder URL
# e.g. https://drive.google.com/drive/folders/XXXXXX → XXXXXX
DRIVE_FOLDER_ID=
